# Copy to <repo root>/.env.local (gitignored) and fill in. Sourced by the cloudrun/ scripts.
export PROJECT_ID="your-gcp-project"
export REGION="us-east4"
export PROJECT_NUMBER="123456789012"
# Numeric Secret Manager versions of the signer keys (versions/latest is not supported).
export PUB_KEY_VERSION=1
export PRIV_KEY_VERSION=1
# Images built with ko from the same TesseraCT tag.
export IMAGE_URI="${REGION}-docker.pkg.dev/${PROJECT_ID}/tesseract-bench/tesseract-gcp:v0.2.0@sha256:..."
export HAMMER_IMAGE="${REGION}-docker.pkg.dev/${PROJECT_ID}/tesseract-bench/tesseract-hammer:v0.2.0@sha256:..."
# Optional: image for run_r8.sh (lease PoC); defaults to .../tesseract-gcp:lease-poc
# export LEASE_IMAGE_URI=...
